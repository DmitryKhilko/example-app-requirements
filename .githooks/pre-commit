#!/bin/sh
# Локальная проверка спецификаций перед коммитом (срабатывает и из терминала, и из VS Code).
# Проверяет спецификации и запрещает ручные правки doc_version, datetime_version и журнала изменений.
# Включение (один раз в клоне): git config core.hooksPath .githooks
# Обход (на этапе разработки): git commit --no-verify

. "$(dirname "$0")/python-env.sh" || exit 1

$PY scripts/generate_docs.py --validate --staged || {
  echo "Коммит отменён: исправьте ошибки в спецификациях (см. выше)."
  exit 1
}
