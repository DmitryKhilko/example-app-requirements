#!/bin/sh
# Повторная проверка спецификаций перед отправкой (на случай коммитов, сделанных в обход pre-commit).
# Включение (один раз в клоне): git config core.hooksPath .githooks
# Обход (на этапе разработки): git push --no-verify

. "$(dirname "$0")/python-env.sh" || exit 1

$PY scripts/generate_docs.py --validate || {
  echo "Push отменён: исправьте ошибки в спецификациях (см. выше)."
  exit 1
}
